# Postgres connection (Supabase). Use the pooled connection string for the app,
# and the direct connection for Prisma migrations.
# Supabase dashboard: Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase Storage for uploaded sighting photos.
# Project Settings -> API. Use the service_role key on the server (preferred).
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="sighting-photos"
# If you only have the publishable/anon key, set it here and add an "insert"
# storage policy on the bucket for the anon role.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. When set, GET /api/cron/ingest requires `Authorization: Bearer <secret>`.
# Production rejects the cron route if this is unset.
CRON_SECRET=
